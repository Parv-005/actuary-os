# --- Database (shared Supabase project, D3) ---
# Pooled URL for the app (pgbouncer, port 6543, ?prepared_statement_cache_size=0 via code)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:6543/postgres
# Direct URL for migrations/DDL (port 5432)
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
# Schema selection: public (default) | test (pytest isolation)
APP_DB_SCHEMA=public

# --- Supabase Storage ---
# backend: supabase | local | memory ([ID] local/memory for offline dev & tests)
STORAGE_BACKEND=supabase
SUPABASE_URL=http://localhost:8001
SUPABASE_SERVICE_KEY=change-me-service-key
SUPABASE_BUCKET=vortex-files

# --- LLM (OpenAI-compatible endpoint, D1) ---
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000
API_VERSION=0.1.0
# Run launched workflows in a background thread (required on any live server:
# sync endpoint workers have no event loop). Always 1 in dev/prod; tests leave
# it off so the suite stays hermetic.
ENGINE_BACKGROUND=1

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
